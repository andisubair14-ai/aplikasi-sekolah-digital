# =========================================
# MODE EMULATOR (LOKAL) — bukan produksi
# =========================================
# File ini HANYA dibaca oleh: npm run dev:emulator
# (Vite mode "emulator"). Perintah `npm run dev` biasa
# dan build produksi TIDAK membaca file ini.
#
# Flag di bawah membelokkan koneksi Firebase ke Emulator
# lokal (lihat src/lib/firebase.ts). Tanpa flag ini,
# aplikasi selalu memakai Firebase Online.
VITE_USE_FIREBASE_EMULATOR=true
