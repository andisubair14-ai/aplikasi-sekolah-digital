rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // IDENTITAS DAN PERAN AKUN
    // ==========================================

    function sudahLogin() {
      return request.auth != null;
    }

    function profilPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profilAda() {
      return sudahLogin() && exists(profilPath());
    }

    function dataProfil() {
      return get(profilPath()).data;
    }

    function akunAktif() {
      return profilAda()
        && dataProfil().get('aktif', true) == true;
    }

    function adminAktif() {
      return akunAktif()
        && dataProfil().get('role', '') == 'admin';
    }

    function guruAktif() {
      return akunAktif()
        && dataProfil().get('role', '') == 'guru';
    }

    function kepsekAktif() {
      return akunAktif()
        && dataProfil().get('role', '') == 'kepsek';
    }

    // ==========================================
    // RELASI GURU DAN ROMBEL
    // ==========================================

    function guruPath() {
      return /databases/$(database)/documents/guru/$(dataProfil().get('guruId', ''));
    }

    function kelasPath(kelasId) {
      return /databases/$(database)/documents/kelas/$(kelasId);
    }

    function guruDitugaskanDiKelas(kelasId) {
      return guruAktif()
        && dataProfil().get('guruId', '') is string
        && dataProfil().get('guruId', '') != ''
        && kelasId is string
        && kelasId != ''
        && exists(kelasPath(kelasId))
        && (
          get(kelasPath(kelasId)).data.get('waliKelasId', '') == dataProfil().get('guruId', '')
          || (
            exists(guruPath())
            && get(guruPath()).data.get('kelasDiampu', []) is list
            && get(guruPath()).data.get('kelasDiampu', []).hasAny([kelasId])
          )
        );
    }

    function jurnalMilikGuru(uid) {
      return resource.data.get('userId', '') == uid
        || resource.data.get('guruId', '') == uid;
    }

    // ==========================================
    // ISOLASI SEKOLAH (MULTI-TENANT)
    // ==========================================
    function sekolahValid() {
      return akunAktif()
        && dataProfil().get('sekolahId', '') is string
        && dataProfil().get('sekolahId', '').size() > 0;
    }

    function sekolahSayaDoc() {
      return sekolahValid()
        && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '');
    }

    function sekolahSayaReq() {
      return sekolahValid()
        && request.resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '');
    }

    function sekolahTidakBerubah() {
      let berubah = 'sekolahId' in request.resource.data.diff(resource.data).affectedKeys();
      return !berubah
        || request.resource.data.get('sekolahId', '') == resource.data.get('sekolahId', '');
    }

    function profilSekolahSaya(uid) {
      let p = /databases/$(database)/documents/users/$(uid);
      return sekolahValid()
        && uid is string
        && exists(p)
        && get(p).data.get('sekolahId', '') == dataProfil().get('sekolahId', '');
    }

    // ==========================================
    // VALIDASI NOTIFIKASI JURNAL
    // ==========================================

    function jurnalSesuaiNotifikasiReview(userId) {
      let jurnalPath = /databases/$(database)/documents/jurnal/$(request.resource.data.referensiId);

      return request.resource.data.get('referensiId', '') is string
        && existsAfter(jurnalPath)
        && (
          getAfter(jurnalPath).data.get('userId', '') == userId
          || getAfter(jurnalPath).data.get('guruId', '') == userId
        )
        && (
          (
            request.resource.data.get('tipe', '') == 'jurnal_disetujui'
            && getAfter(jurnalPath).data.get('status', '') == 'Disetujui'
          )
          ||
          (
            request.resource.data.get('tipe', '') == 'jurnal_revisi'
            && getAfter(jurnalPath).data.get('status', '') == 'Perlu Perbaikan'
          )
        );
    }

    function jurnalSesuaiNotifikasiPengiriman() {
      let jurnalPath = /databases/$(database)/documents/jurnal/$(request.resource.data.referensiId);

      return request.resource.data.get('referensiId', '') is string
        && existsAfter(jurnalPath)
        && getAfter(jurnalPath).data.get('userId', '') == request.auth.uid
        && getAfter(jurnalPath).data.get('guruId', '') == request.auth.uid
        && getAfter(jurnalPath).data.get('status', '') == 'Dikirim'
        && request.resource.data.get('pengirimUid', '') == request.auth.uid;
    }

    function bolehHapusNotifikasiPengiriman(userId) {
      let jurnalId = resource.data.get('referensiId', '');
      let jurnalPath = /databases/$(database)/documents/jurnal/$(jurnalId);

      return guruAktif()
        && get(/databases/$(database)/documents/users/$(userId)).data.get('role', '') == 'kepsek'
        && resource.data.get('tipe', '') == 'jurnal_dikirim'
        && resource.data.get('pengirimUid', '') == request.auth.uid
        && jurnalId is string
        && exists(jurnalPath)
        && (
          get(jurnalPath).data.get('userId', '') == request.auth.uid
          || get(jurnalPath).data.get('guruId', '') == request.auth.uid
        )
        && get(jurnalPath).data.get('status', '') in ['Dikirim', 'Perlu Perbaikan']
        && !existsAfter(jurnalPath);
    }

    // ==========================================
    // VALIDASI DOKUMEN ABSENSI SISWA
    // ==========================================

    function absensiValid(data) {
      return data.keys().hasAll([
          'tanggal', 'nisn', 'namaSiswa', 'kelas', 'kelasId',
          'jenjang', 'tingkat', 'tahunAjaran', 'status', 'metode',
          'kirimNotifikasiWaAlpa', 'waktuScan', 'dicatatOleh',
          'dicatatOlehUid', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'tanggal', 'nisn', 'namaSiswa', 'kelas', 'kelasId',
          'jenjang', 'tingkat', 'tahunAjaran', 'status', 'metode',
          'kirimNotifikasiWaAlpa', 'waktuScan', 'dicatatOleh',
          'dicatatOlehUid', 'updatedAt'
        ])
        && data.get('tanggal', '') is string
        && data.get('nisn', '') is string
        && data.get('kelasId', '') is string
        && data.get('status', '') in ['Hadir', 'Sakit', 'Izin', 'Alpa']
        && data.get('metode', '') in ['Manual', 'Scan QR']
        && data.get('kirimNotifikasiWaAlpa', false) is bool
        && data.get('dicatatOlehUid', '') is string
        && data.get('dicatatOleh', '') is string
        && data.get('waktuScan', '') is string
        && data.get('updatedAt', '') is string;
    }

    // ==========================================
    // VALIDASI ABSENSI GURU & QR DINAMIS
    // ==========================================

    function formatTanggalValid(tanggalStr) {
      return tanggalStr is string 
        && tanggalStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function qrTokenGuruMasihAktif(token) {
      let qrPath = /databases/$(database)/documents/pengaturan/qr_absensi_guru;
      return token is string
        && token.size() == 48
        && exists(qrPath)
        && get(qrPath).data.get('token', '') == token
        && get(qrPath).data.get('expiresAt', request.time) is timestamp
        && get(qrPath).data.expiresAt > request.time;
    }

    function guruIdentityValid() {
      let guruId = request.resource.data.guruId;
      let gPath = /databases/$(database)/documents/guru/$(guruId);
      return exists(gPath)
        && get(gPath).data.get('nama', '') == request.resource.data.namaGuru
        && get(gPath).data.get('nip', '') == request.resource.data.nip;
    }

    function absensiGuruValid(absensiId) {
      return request.resource.data.keys().hasAll([
        'tanggal', 'guruId', 'namaGuru', 'nip', 'status',
        'waktuMasuk', 'waktuPulang', 'catatan', 'dicatatOlehUid',
        'createdAt', 'updatedAt'
      ])
      && request.resource.data.keys().hasOnly([
        'tanggal', 'guruId', 'namaGuru', 'nip', 'status',
        'waktuMasuk', 'waktuPulang', 'catatan', 'dicatatOlehUid',
        'createdAt', 'updatedAt', 'qrToken', 'qrTokenPulang'
      ])
      && formatTanggalValid(request.resource.data.tanggal)
      && request.resource.data.guruId is string
      && request.resource.data.guruId.size() > 0
      && request.resource.data.namaGuru is string
      && request.resource.data.nip is string
      && request.resource.data.status in ['Hadir', 'Izin', 'Sakit', 'Dinas Luar', 'Alpa']
      && (
        (request.resource.data.waktuMasuk is string && request.resource.data.waktuMasuk == '') ||
        (request.resource.data.waktuMasuk is timestamp)
      )
      && (
        (request.resource.data.waktuPulang is string && request.resource.data.waktuPulang == '') ||
        (request.resource.data.waktuPulang is timestamp)
      )
      && request.resource.data.catatan is string
      && request.resource.data.dicatatOlehUid is string
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp
      && (!('qrToken' in request.resource.data) || request.resource.data.qrToken is string)
      && (!('qrTokenPulang' in request.resource.data) || request.resource.data.qrTokenPulang is string)
      && absensiId == request.resource.data.tanggal + '_' + request.resource.data.guruId;
    }

    // ==========================================
    // PROFIL PENGGUNA DAN NOTIFIKASI
    // ==========================================

    match /users/{userId} {
      allow get: if sekolahSayaDoc()
        && ((sudahLogin() && request.auth.uid == userId) || adminAktif());
      allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '')
        && (adminAktif() || (guruAktif() && resource.data.get('role', '') == 'kepsek'));
      allow create: if sekolahSayaReq() && adminAktif();
      allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && adminAktif();
      allow delete: if sekolahSayaDoc() && adminAktif()
        && userId != request.auth.uid && resource.data.get('role', '') != 'admin';

      match /notifikasi/{notificationId} {
        allow get: if profilSekolahSaya(userId) && ((akunAktif() && request.auth.uid == userId) || (
          guruAktif()
          && get(/databases/$(database)/documents/users/$(userId)).data.get('role', '') == 'kepsek'
          && resource.data.get('tipe', '') == 'jurnal_dikirim'
          && resource.data.get('pengirimUid', '') == request.auth.uid
        ));
        allow list: if profilSekolahSaya(userId) && ((akunAktif() && request.auth.uid == userId) || (
          guruAktif()
          && get(/databases/$(database)/documents/users/$(userId)).data.get('role', '') == 'kepsek'
          && resource.data.get('tipe', '') == 'jurnal_dikirim'
          && resource.data.get('pengirimUid', '') == request.auth.uid
        ));

        allow create: if profilSekolahSaya(userId) && ((
          kepsekAktif()
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.get('role', '') == 'guru'
          && request.resource.data.keys().hasAll(['judul','pesan','tipe','dibaca','dibuatPada','tautan','referensiId','pengirimUid'])
          && request.resource.data.keys().hasOnly(['judul','pesan','tipe','dibaca','dibuatPada','tautan','referensiId','pengirimUid'])
          && request.resource.data.get('dibaca', true) == false
          && request.resource.data.get('pengirimUid', '') == request.auth.uid
          && request.resource.data.get('tipe', '') in ['jurnal_disetujui', 'jurnal_revisi']
          && jurnalSesuaiNotifikasiReview(userId)
        ) || (
          guruAktif()
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.get('role', '') == 'kepsek'
          && request.resource.data.keys().hasAll(['judul','pesan','tipe','dibaca','dibuatPada','tautan','referensiId','pengirimUid'])
          && request.resource.data.keys().hasOnly(['judul','pesan','tipe','dibaca','dibuatPada','tautan','referensiId','pengirimUid'])
          && request.resource.data.get('dibaca', true) == false
          && request.resource.data.get('pengirimUid', '') == request.auth.uid
          && request.resource.data.get('tipe', '') == 'jurnal_dikirim'
          && jurnalSesuaiNotifikasiPengiriman()
        ));

        allow update: if profilSekolahSaya(userId) && (akunAktif() && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dibaca', 'dibacaPada'])
          && request.resource.data.get('dibaca', false) == true);

        allow delete: if profilSekolahSaya(userId) && (bolehHapusNotifikasiPengiriman(userId));
      }
    }

    // ==========================================
    // DATA GURU
    // ==========================================

    match /guru/{guruId} {
      allow get: if sekolahSayaDoc() && (adminAktif() || kepsekAktif() || (guruAktif() && dataProfil().get('guruId', '') == guruId));
      allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || kepsekAktif());
      allow create: if sekolahSayaReq() && (adminAktif());
      allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
      allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
    }

    // ==========================================
    // DATA KELAS / ROMBEL
    // ==========================================

    match /kelas/{kelasId} {
      allow get: if sekolahSayaDoc() && (akunAktif());
      allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (akunAktif());
      allow create: if sekolahSayaReq() && (adminAktif());
      allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
      allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
    }

    // ==========================================
    // DATA SISWA
    // ==========================================

    match /siswa/{siswaId} {
      allow get: if sekolahSayaDoc() && (adminAktif() || kepsekAktif());
      allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || kepsekAktif());
      allow create: if sekolahSayaReq() && (adminAktif());
      allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
      allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
    }

    match /siswa_ringkas/{siswaId} {
      allow get: if sekolahSayaDoc() && (adminAktif() || (guruAktif() && guruDitugaskanDiKelas(resource.data.get('kelasId', ''))));
      allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || (guruAktif() && guruDitugaskanDiKelas(resource.data.get('kelasId', ''))));
      allow create: if sekolahSayaReq() && (adminAktif());
      allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
      allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
    }

    // ==========================================
    // ABSENSI SISWA
    // ==========================================

    match /absensi/{absensiId} {
      allow get: if sekolahSayaDoc() && (adminAktif() || kepsekAktif() || (guruAktif() && guruDitugaskanDiKelas(resource.data.get('kelasId', ''))));
      allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || kepsekAktif() || (guruAktif() && guruDitugaskanDiKelas(resource.data.get('kelasId', ''))));
      allow create: if sekolahSayaReq() && (adminAktif() || (
        guruAktif()
        && absensiValid(request.resource.data)
        && request.resource.data.get('dicatatOlehUid', '') == request.auth.uid
        && guruDitugaskanDiKelas(request.resource.data.get('kelasId', ''))
      ));
      allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif() || (
        guruAktif()
        && absensiValid(request.resource.data)
        && resource.data.get('kelasId', '') == request.resource.data.get('kelasId', '')
        && request.resource.data.get('dicatatOlehUid', '') == request.auth.uid
        && guruDitugaskanDiKelas(request.resource.data.get('kelasId', ''))
      ));
      allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
    }

    // ==========================================
    // ABSENSI GURU
    // ==========================================

    match /absensi_guru/{absensiId} {
      allow get: if sekolahSayaDoc() && (adminAktif() || kepsekAktif() || (
        guruAktif()
        && dataProfil().get('guruId', '') is string
        && resource.data.get('guruId', '') == dataProfil().get('guruId', '')
      ));
      allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || kepsekAktif() || (
        guruAktif()
        && dataProfil().get('guruId', '') is string
        && resource.data.get('guruId', '') == dataProfil().get('guruId', '')
      ));

      allow create: if sekolahSayaReq() && ((
        adminAktif()
        && absensiGuruValid(absensiId)
      ) || (
        guruAktif()
        && absensiGuruValid(absensiId)
        && dataProfil().get('guruId', '') is string
        && request.resource.data.guruId == dataProfil().get('guruId', '')
        && guruIdentityValid()
        && request.resource.data.dicatatOlehUid == request.auth.uid
        && request.resource.data.status == 'Hadir'
        && request.resource.data.waktuMasuk is timestamp
        && request.resource.data.waktuMasuk == request.time
        && request.resource.data.waktuPulang == ''
        && request.resource.data.catatan == ''
        && request.resource.data.get('qrTokenPulang', '') == ''
        && qrTokenGuruMasihAktif(request.resource.data.get('qrToken', ''))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
      ));

      allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && ((
        adminAktif()
        && absensiGuruValid(absensiId)
      ) || (
        guruAktif()
        && absensiGuruValid(absensiId)
        && resource.data.get('guruId', '') == dataProfil().get('guruId', '')
        && resource.data.get('dicatatOlehUid', '') == request.auth.uid
        && resource.data.get('status', '') == 'Hadir'
        && resource.data.get('waktuMasuk', '') is timestamp
        && resource.data.get('waktuMasuk', '') != ''
        && resource.data.get('waktuPulang', '') == ''
        && request.resource.data.waktuPulang is timestamp
        && request.resource.data.waktuPulang == request.time
        && request.resource.data.get('qrTokenPulang', '') != ''
        && qrTokenGuruMasihAktif(request.resource.data.get('qrTokenPulang', ''))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waktuPulang', 'updatedAt', 'qrTokenPulang'])
      ));

      allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
    }

    // ==========================================
    // JURNAL MENGAJAR
    // ==========================================

    match /jurnal/{jurnalId} {
      allow get: if sekolahSayaDoc() && (adminAktif() || kepsekAktif() || (guruAktif() && jurnalMilikGuru(request.auth.uid)));
      allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || kepsekAktif() || (guruAktif() && jurnalMilikGuru(request.auth.uid)));

      allow create: if sekolahSayaReq() && (adminAktif() || (
        guruAktif()
        && request.resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.get('guruId', '') == request.auth.uid
        && request.resource.data.get('pegawaiId', '') == dataProfil().get('guruId', '')
        && request.resource.data.get('status', '') == 'Dikirim'
        && guruDitugaskanDiKelas(request.resource.data.get('kelasId', ''))
        && request.resource.data.keys().hasAll([
          'userId', 'pegawaiId', 'guruId', 'namaGuru', 'tanggal', 'jamKe',
          'kelasId', 'kelas', 'jenjang', 'tingkat', 'tahunAjaran', 'semester',
          'mataPelajaran', 'tema', 'tujuan', 'kegiatanMedia', 'absensiSiswa',
          'refleksi', 'status', 'catatanKepsek', 'updatedAt', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'pegawaiId', 'guruId', 'namaGuru', 'tanggal', 'jamKe',
          'kelasId', 'kelas', 'jenjang', 'tingkat', 'tahunAjaran', 'semester',
          'mataPelajaran', 'tema', 'tujuan', 'kegiatanMedia', 'absensiSiswa',
          'refleksi', 'status', 'catatanKepsek', 'updatedAt', 'createdAt'
        ])
      ));

      allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif() || (
        guruAktif()
        && jurnalMilikGuru(request.auth.uid)
        && resource.data.get('status', '') in ['Dikirim', 'Perlu Perbaikan']
        && request.resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.get('guruId', '') == request.auth.uid
        && request.resource.data.get('pegawaiId', '') == dataProfil().get('guruId', '')
        && request.resource.data.get('status', '') == 'Dikirim'
        && guruDitugaskanDiKelas(request.resource.data.get('kelasId', ''))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'namaGuru', 'tanggal', 'jamKe', 'kelasId', 'kelas', 'jenjang',
          'tingkat', 'tahunAjaran', 'semester', 'mataPelajaran', 'tema',
          'tujuan', 'kegiatanMedia', 'absensiSiswa', 'refleksi', 'status',
          'catatanKepsek', 'updatedAt'
        ])
      ) || (
        kepsekAktif()
        && resource.data.get('status', '') == 'Dikirim'
        && request.resource.data.get('status', '') in ['Disetujui', 'Perlu Perbaikan']
        && request.resource.data.get('userId', '') == resource.data.get('userId', '')
        && request.resource.data.get('guruId', '') == resource.data.get('guruId', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'catatanKepsek', 'diprosesOlehUid', 'diprosesPada'
        ])
        && request.resource.data.get('diprosesOlehUid', '') == request.auth.uid
      ));

      allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif() || (
        guruAktif()
        && jurnalMilikGuru(request.auth.uid)
        && resource.data.get('status', '') in ['Dikirim', 'Perlu Perbaikan']
      ));
    }

    // ==========================================
    // TAHUN AJARAN
    // ==========================================

    match /tahun_ajaran/{tahunAjaranId} {
      allow get: if sekolahSayaDoc() && (adminAktif() || ((guruAktif() || kepsekAktif()) && resource.data.get('status', '') == 'Aktif'));
      allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || ((guruAktif() || kepsekAktif()) && resource.data.get('status', '') == 'Aktif'));
      allow create: if sekolahSayaReq() && (adminAktif());
      allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
      allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
    }

    // ==========================================
    // PENGATURAN SEKOLAH
    // ==========================================

    
match /pengaturan/{pengaturanId} {

  // Platform Owner hanya boleh membaca dokumen koordinat sekolah.
  allow get: if sudahLogin()
    && request.auth.token.platformOwner == true
    && pengaturanId == 'sekolah';

  allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && akunAktif()
    && pengaturanId != 'backup_sekolah'
    && (pengaturanId != 'qr_absensi_guru' || adminAktif());
  allow get: if sekolahSayaDoc() && akunAktif()
    && pengaturanId != 'backup_sekolah'
    && (pengaturanId != 'qr_absensi_guru' || adminAktif());

  allow create: if sekolahSayaReq() && adminAktif()
    && pengaturanId != 'backup_sekolah'
    && (
      pengaturanId != 'qr_absensi_guru' ||
      (
        request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'h')
      )
    );
  allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && adminAktif()
    && pengaturanId != 'backup_sekolah'
    && (
      pengaturanId != 'qr_absensi_guru' ||
      (
        request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'h')
      )
    );

  allow delete: if sekolahSayaDoc() && adminAktif()
    && pengaturanId != 'backup_sekolah'
    && pengaturanId != 'qr_absensi_guru';
}


    // ==========================================
    // INVENTARIS SARANA DAN PRASARANA
    // ==========================================

    function inventarisSarprasValid(data) {
      return data.keys().hasAll([
          'kodeInventaris', 'namaBarang', 'kategori', 'merkTipe', 'jumlah',
          'satuan', 'kondisi', 'tahunPerolehan', 'sumberDana', 'lokasi',
          'keterangan', 'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid'
        ])
        && data.keys().hasOnly([
          'kodeInventaris', 'namaBarang', 'kategori', 'merkTipe', 'jumlah',
          'satuan', 'kondisi', 'tahunPerolehan', 'sumberDana', 'lokasi',
          'keterangan', 'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid'
        ])
        && data.get('kodeInventaris', '') is string
        && data.get('namaBarang', '') is string
        && data.get('namaBarang', '').size() > 0
        && data.get('kategori', '') in [
          'Elektronik', 'Mebel', 'Alat Pembelajaran', 'Peralatan Kantor',
          'Olahraga', 'Kebersihan', 'Peralatan', 'Lainnya'
        ]
        && data.get('merkTipe', '') is string
        && data.get('jumlah', 0) is int
        && data.get('jumlah', 0) >= 1
        && data.get('jumlah', 0) <= 999999
        && data.get('satuan', '') in [
          'Unit', 'Buah', 'Set', 'Pasang', 'Eksemplar', 'Meter', 'Lainnya'
        ]
        && data.get('kondisi', '') in ['Baik', 'Rusak Ringan', 'Rusak Berat']
        && data.get('tahunPerolehan', '') is string
        && data.get('tahunPerolehan', '').matches('^[0-9]{4}$')
        && data.get('sumberDana', '') is string
        && data.get('lokasi', '') is string
        && data.get('lokasi', '').size() > 0
        && data.get('keterangan', '') is string
        && data.get('createdAt', null) is timestamp
        && data.get('updatedAt', null) is timestamp
        && data.get('createdByUid', '') is string
        && data.get('updatedByUid', '') is string;
    }
    
    match /inventaris_sarpras/{itemId} {
      // Admin dan Kepala Sekolah dapat membaca data inventaris.
      allow get: if sekolahSayaDoc() && (adminAktif() || kepsekAktif());
      allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || kepsekAktif());
    
      // Hanya Admin yang boleh menambah data.
      allow create: if sekolahSayaReq() && (adminAktif()
        && inventarisSarprasValid(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid);
    
      // Hanya Admin yang boleh mengubah data. Identitas pembuat dan waktu dibuat tetap.
      allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif()
        && inventarisSarprasValid(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.updatedByUid == request.auth.uid);
    
      // Hanya Admin yang boleh menghapus data.
      allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
    }
    

    // ==========================================
    // MODUL SARPRAS: RUANG, FASILITAS, PEMELIHARAAN
    // ==========================================

    function ruangFasilitasSarprasValid(data) {
      return data.keys().hasAll([
          'kodeRuang', 'namaRuang', 'jenisRuang', 'lokasiGedung', 'kapasitas', 'luas',
          'kondisi', 'statusPenggunaan', 'fasilitas', 'penanggungJawab', 'keterangan',
          'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid'
        ])
        && data.keys().hasOnly([
          'kodeRuang', 'namaRuang', 'jenisRuang', 'lokasiGedung', 'kapasitas', 'luas',
          'kondisi', 'statusPenggunaan', 'fasilitas', 'penanggungJawab', 'keterangan',
          'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid'
        ])
        && data.get('kodeRuang', '') is string
        && data.get('namaRuang', '') is string
        && data.get('namaRuang', '').size() > 0
        && data.get('jenisRuang', '') in [
          'Ruang Kelas', 'Ruang Kepala Sekolah', 'Ruang Guru', 'Tata Usaha',
          'Perpustakaan', 'Laboratorium', 'UKS', 'Toilet', 'Gudang', 'Aula',
          'Mushola', 'Ruang Lainnya'
        ]
        && data.get('lokasiGedung', '') is string
        && data.get('lokasiGedung', '').size() > 0
        && data.get('kapasitas', 0) is int
        && data.get('kapasitas', 0) >= 0
        && data.get('kapasitas', 0) <= 10000
        && data.get('luas', 0) is number
        && data.get('luas', 0) >= 0
        && data.get('luas', 0) <= 100000
        && data.get('kondisi', '') in ['Baik', 'Perlu Perhatian', 'Rusak']
        && data.get('statusPenggunaan', '') in ['Aktif', 'Tidak Aktif']
        && data.get('fasilitas', '') is string
        && data.get('penanggungJawab', '') is string
        && data.get('keterangan', '') is string
        && data.get('createdAt', null) is timestamp
        && data.get('updatedAt', null) is timestamp
        && data.get('createdByUid', '') is string
        && data.get('updatedByUid', '') is string;
    }

    match /ruang_fasilitas_sarpras/{ruangId} {
      // Admin dan Kepala Sekolah dapat melihat data ruang.
      allow get: if sekolahSayaDoc() && (adminAktif() || kepsekAktif());
      allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || kepsekAktif());

      // Pengelolaan data ruang hanya dilakukan Admin.
      allow create: if sekolahSayaReq() && (adminAktif()
        && ruangFasilitasSarprasValid(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid);

      allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif()
        && ruangFasilitasSarprasValid(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.updatedByUid == request.auth.uid);

      allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
    }

    function pemeliharaanSarprasValid(data) {
      return data.keys().hasAll([
          'kodeLaporan', 'jenisAset', 'assetId', 'namaAset', 'lokasi', 'kategoriKerusakan',
          'uraian', 'prioritas', 'status', 'tanggalLaporan', 'biaya', 'tindakan', 'pelaksana',
          'tanggalSelesai', 'catatan', 'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid'
        ])
        && data.keys().hasOnly([
          'kodeLaporan', 'jenisAset', 'assetId', 'namaAset', 'lokasi', 'kategoriKerusakan',
          'uraian', 'prioritas', 'status', 'tanggalLaporan', 'biaya', 'tindakan', 'pelaksana',
          'tanggalSelesai', 'catatan', 'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid'
        ])
        && data.get('kodeLaporan', '') is string
        && data.get('jenisAset', '') in ['Inventaris', 'Ruang/Fasilitas', 'Umum']
        && data.get('assetId', '') is string
        && data.get('namaAset', '') is string
        && data.get('namaAset', '').size() > 0
        && data.get('lokasi', '') is string
        && data.get('kategoriKerusakan', '') is string
        && data.get('uraian', '') is string
        && data.get('uraian', '').size() > 0
        && data.get('prioritas', '') in ['Rendah', 'Sedang', 'Tinggi', 'Darurat']
        && data.get('status', '') in [
          'Dilaporkan', 'Dijadwalkan', 'Dalam Proses', 'Selesai', 'Tidak Dapat Diperbaiki'
        ]
        && data.get('tanggalLaporan', '') is string
        && data.get('tanggalLaporan', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.get('biaya', 0) is number
        && data.get('biaya', 0) >= 0
        && data.get('biaya', 0) <= 1000000000000
        && data.get('tindakan', '') is string
        && data.get('pelaksana', '') is string
        && data.get('tanggalSelesai', '') is string
        && (data.get('tanggalSelesai', '') == '' || data.get('tanggalSelesai', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.get('catatan', '') is string
        && data.get('createdAt', null) is timestamp
        && data.get('updatedAt', null) is timestamp
        && data.get('createdByUid', '') is string
        && data.get('updatedByUid', '') is string;
    }

    match /pemeliharaan_sarpras/{laporanId} {
      // Admin dan Kepala Sekolah dapat membaca laporan pemeliharaan.
      allow get: if sekolahSayaDoc() && (adminAktif() || kepsekAktif());
      allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || kepsekAktif());

      // Hanya Admin yang dapat membuat, mengubah, dan menghapus catatan.
      allow create: if sekolahSayaReq() && (adminAktif()
        && pemeliharaanSarprasValid(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid);

      allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif()
        && pemeliharaanSarprasValid(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.updatedByUid == request.auth.uid);

      allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
    }

    // ==========================================
    // PENGUMUMAN SEKOLAH
    // ==========================================

    function pengumumanSekolahValid(data) {
      return data.keys().hasAll([
          'judul', 'kategori', 'isi', 'prioritas', 'sasaran', 'status',
          'tautanLampiran', 'sematkan', 'createdAt', 'updatedAt',
          'createdByUid', 'createdByNama', 'updatedByUid', 'updatedByNama'
        ])
        && data.keys().hasOnly([
          'judul', 'kategori', 'isi', 'prioritas', 'sasaran', 'status',
          'tautanLampiran', 'sematkan', 'createdAt', 'updatedAt',
          'createdByUid', 'createdByNama', 'updatedByUid', 'updatedByNama'
        ])
        && data.get('judul', '') is string
        && data.get('judul', '').size() > 0
        && data.get('judul', '').size() <= 150
        && data.get('kategori', '') in ['Akademik', 'Kegiatan', 'Kepegawaian', 'Informasi', 'Umum']
        && data.get('isi', '') is string
        && data.get('isi', '').size() > 0
        && data.get('prioritas', '') in ['Normal', 'Penting']
        && data.get('sasaran', []) is list
        && data.get('sasaran', []).size() >= 1
        && data.get('sasaran', []).hasOnly(['guru', 'kepsek'])
        && data.get('status', '') in ['Draft', 'Terbit', 'Arsip']
        && data.get('tautanLampiran', '') is string
        && data.get('sematkan', false) is bool
        && data.get('createdAt', null) is timestamp
        && data.get('updatedAt', null) is timestamp
        && data.get('createdByUid', '') is string
        && data.get('createdByNama', '') is string
        && data.get('updatedByUid', '') is string
        && data.get('updatedByNama', '') is string;
    }

    match /pengumuman_sekolah/{pengumumanId} {
      // Admin dan Kepala Sekolah dapat melihat seluruh status.
      // Guru hanya dapat membaca pengumuman terbit yang ditujukan kepada Guru.
      allow get: if sekolahSayaDoc() && (adminAktif() || kepsekAktif() || (
        guruAktif()
        && resource.data.get('status', '') == 'Terbit'
        && resource.data.get('sasaran', []).hasAny(['guru'])
      ));
      allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || kepsekAktif() || (
        guruAktif()
        && resource.data.get('status', '') == 'Terbit'
        && resource.data.get('sasaran', []).hasAny(['guru'])
      ));

      // Admin dan Kepala Sekolah dapat membuat pengumuman.
      allow create: if sekolahSayaReq() && ((adminAktif() || kepsekAktif())
        && pengumumanSekolahValid(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (adminAktif() || request.resource.data.sematkan == false));

      // Admin dapat mengelola semua pengumuman.
      // Kepala Sekolah hanya dapat mengubah pengumuman miliknya sendiri dan tidak dapat menyematkan.
      allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && ((
        adminAktif()
        && pengumumanSekolahValid(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
      ) || (
        kepsekAktif()
        && resource.data.get('createdByUid', '') == request.auth.uid
        && pengumumanSekolahValid(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.sematkan == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'judul', 'kategori', 'isi', 'prioritas', 'sasaran', 'status',
          'tautanLampiran', 'updatedAt', 'updatedByUid', 'updatedByNama'
        ])
      ));

      // Penghapusan hanya dapat dilakukan Admin.
      allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
    }
// =====================================================
// JADWAL PELAJARAN
// Tempelkan di dalam match /databases/{database}/documents
// sebelum kurung penutup paling bawah.
// =====================================================

function jadwalPelajaranValid(data) {
  let guruPathJadwal = /databases/$(database)/documents/guru/$(data.get('guruId', ''));
  let kelasPathJadwal = /databases/$(database)/documents/kelas/$(data.get('kelasId', ''));

  return data.keys().hasAll([
      'kelasId', 'namaKelas', 'jenjang', 'guruId', 'namaGuru',
      'mataPelajaran', 'hari', 'jamMulai', 'jamSelesai', 'ruang',
      'tahunAjaran', 'semester', 'keterangan', 'createdAt',
      'updatedAt', 'createdByUid', 'updatedByUid'
    ])
    && data.keys().hasOnly([
      'kelasId', 'namaKelas', 'jenjang', 'guruId', 'namaGuru',
      'mataPelajaran', 'hari', 'jamMulai', 'jamSelesai', 'ruang',
      'tahunAjaran', 'semester', 'keterangan', 'createdAt',
      'updatedAt', 'createdByUid', 'updatedByUid'
    ])
    && data.get('kelasId', '') is string
    && data.get('kelasId', '').size() > 0
    && data.get('namaKelas', '') is string
    && data.get('jenjang', '') is string
    && data.get('guruId', '') is string
    && data.get('guruId', '').size() > 0
    && data.get('namaGuru', '') is string
    && data.get('mataPelajaran', '') is string
    && data.get('mataPelajaran', '').size() > 0
    && data.get('hari', '') in ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu']
    && data.get('jamMulai', '') is string
    && data.get('jamMulai', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
    && data.get('jamSelesai', '') is string
    && data.get('jamSelesai', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')

    && data.get('ruang', '') is string
    && data.get('tahunAjaran', '') is string
    && data.get('tahunAjaran', '').size() > 0
    && data.get('semester', '') is string
    && data.get('semester', '').size() > 0
    && data.get('keterangan', '') is string
    && data.get('createdAt', null) is timestamp
    && data.get('updatedAt', null) is timestamp
    && data.get('createdByUid', '') is string
    && data.get('updatedByUid', '') is string
    && exists(guruPathJadwal)
    && exists(kelasPathJadwal)
    && get(guruPathJadwal).data.get('nama', '') == data.get('namaGuru', '')
    && get(kelasPathJadwal).data.get('namaKelas', '') == data.get('namaKelas', '');
}

match /jadwal_pelajaran/{jadwalId} {
  // Guru hanya dapat membaca jadwal yang ditugaskan kepada identitas gurunya.
  // Kepala Sekolah dan Admin dapat membaca seluruh jadwal.
  allow get: if sekolahSayaDoc() && (adminAktif() || kepsekAktif() || (
    guruAktif()
    && dataProfil().get('guruId', '') is string
    && resource.data.get('guruId', '') == dataProfil().get('guruId', '')
  ));
  allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || kepsekAktif() || (
    guruAktif()
    && dataProfil().get('guruId', '') is string
    && resource.data.get('guruId', '') == dataProfil().get('guruId', '')
  ));

  // Hanya Admin yang dapat menambah, mengubah, dan menghapus jadwal.
  allow create: if sekolahSayaReq() && (adminAktif()
    && jadwalPelajaranValid(request.resource.data)
    && request.resource.data.get('createdByUid', '') == request.auth.uid
    && request.resource.data.get('updatedByUid', '') == request.auth.uid);

  allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif()
    && jadwalPelajaranValid(request.resource.data)
    && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
    && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
    && request.resource.data.get('updatedByUid', '') == request.auth.uid);

  allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif());
}
// =====================================================
// PENILAIAN SISWA - TAMBAHAN FIRESTORE RULES
// Tempelkan di dalam match /databases/{database}/documents
// pada tingkat yang sama dengan match koleksi lainnya,
// sebelum kurung penutup match paling bawah.
// Jangan mengganti atau menghapus aturan lama.
// =====================================================

function penilaianSiswaValid(data) {
  let kelasPathPenilaian = /databases/$(database)/documents/kelas/$(data.get('kelasId', ''));

  return data.keys().hasAll([
      'judulPenilaian', 'jenisPenilaian', 'kelasId', 'namaKelas',
      'jenjang', 'tingkat', 'guruId', 'userId', 'namaGuru',
      'mataPelajaran', 'tanggal', 'tahunAjaran', 'semester',
      'nilaiMaksimal', 'keterangan', 'createdAt', 'updatedAt',
      'createdByUid', 'updatedByUid'
    ])
    && data.keys().hasOnly([
      'judulPenilaian', 'jenisPenilaian', 'kelasId', 'namaKelas',
      'jenjang', 'tingkat', 'guruId', 'userId', 'namaGuru',
      'mataPelajaran', 'tanggal', 'tahunAjaran', 'semester',
      'nilaiMaksimal', 'keterangan', 'createdAt', 'updatedAt',
      'createdByUid', 'updatedByUid'
    ])
    && data.get('judulPenilaian', '') is string
    && data.get('judulPenilaian', '').size() > 0
    && data.get('jenisPenilaian', '') in ['Formatif', 'Sumatif', 'Tugas', 'Ulangan', 'Praktik', 'Proyek']
    && data.get('kelasId', '') is string
    && data.get('kelasId', '').size() > 0
    && data.get('namaKelas', '') is string
    && data.get('jenjang', '') is string
    && data.get('tingkat', '') is string
    && data.get('guruId', '') is string
    && data.get('guruId', '').size() > 0
    && data.get('userId', '') is string
    && data.get('userId', '').size() > 0
    && data.get('namaGuru', '') is string
    && data.get('mataPelajaran', '') is string
    && data.get('mataPelajaran', '').size() > 0
    && data.get('tanggal', '') is string
    && data.get('tanggal', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && data.get('tahunAjaran', '') is string
    && data.get('tahunAjaran', '').size() > 0
    && data.get('semester', '') is string
    && data.get('semester', '').size() > 0
    && data.get('nilaiMaksimal', 0) is number
    && data.get('nilaiMaksimal', 0) > 0
    && data.get('nilaiMaksimal', 0) <= 100
    && data.get('keterangan', '') is string
    && data.get('createdAt', null) is timestamp
    && data.get('updatedAt', null) is timestamp
    && data.get('createdByUid', '') is string
    && data.get('updatedByUid', '') is string
    && exists(kelasPathPenilaian)
    && get(kelasPathPenilaian).data.get('namaKelas', '') == data.get('namaKelas', '')
    && guruDitugaskanDiKelas(data.get('kelasId', ''));
}

function guruPemilikPenilaian(penilaianId) {
  let penilaianPath = /databases/$(database)/documents/penilaian_siswa/$(penilaianId);

  return guruAktif()
    && exists(penilaianPath)
    && get(penilaianPath).data.get('userId', '') == request.auth.uid
    && get(penilaianPath).data.get('guruId', '') == dataProfil().get('guruId', '')
    && guruDitugaskanDiKelas(get(penilaianPath).data.get('kelasId', ''));
}

function nilaiSiswaValid(data, penilaianId, siswaId) {
  let penilaianPath = /databases/$(database)/documents/penilaian_siswa/$(penilaianId);

  return exists(penilaianPath)
    && data.keys().hasAll([
      'siswaId', 'namaSiswa', 'kelasId', 'nilai', 'catatan',
      'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid'
    ])
    && data.keys().hasOnly([
      'siswaId', 'namaSiswa', 'kelasId', 'nilai', 'catatan',
      'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid'
    ])
    && data.get('siswaId', '') == siswaId
    && data.get('namaSiswa', '') is string
    && data.get('kelasId', '') == get(penilaianPath).data.get('kelasId', '')
    && data.get('nilai', -1) is number
    && data.get('nilai', -1) >= 0
    && data.get('nilai', -1) <= get(penilaianPath).data.get('nilaiMaksimal', 100)
    && data.get('catatan', '') is string
    && data.get('createdAt', null) is timestamp
    && data.get('updatedAt', null) is timestamp
    && data.get('createdByUid', '') is string
    && data.get('updatedByUid', '') is string;
}

match /penilaian_siswa/{penilaianId} {
  // Admin dan Kepala Sekolah dapat membaca seluruh penilaian.
  // Guru hanya dapat membaca penilaian yang dibuat oleh akun Guru tersebut.
  allow get: if sekolahSayaDoc() && (adminAktif() || kepsekAktif() || (
    guruAktif()
    && resource.data.get('userId', '') == request.auth.uid
  ));
  allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || kepsekAktif() || (
    guruAktif()
    && resource.data.get('userId', '') == request.auth.uid
  ));

  // Guru hanya dapat membuat penilaian untuk rombel yang menjadi penugasannya.
  allow create: if sekolahSayaReq() && (guruAktif()
    && penilaianSiswaValid(request.resource.data)
    && request.resource.data.get('userId', '') == request.auth.uid
    && request.resource.data.get('guruId', '') == dataProfil().get('guruId', '')
    && request.resource.data.get('createdByUid', '') == request.auth.uid
    && request.resource.data.get('updatedByUid', '') == request.auth.uid);

  // Guru pemilik atau Admin dapat menghapus penilaian.
  // Aplikasi menghapus subkoleksi nilai terlebih dahulu sebelum menghapus dokumen induk.
  allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif() || (
    guruAktif()
    && resource.data.get('userId', '') == request.auth.uid
    && resource.data.get('guruId', '') == dataProfil().get('guruId', '')
    && guruDitugaskanDiKelas(resource.data.get('kelasId', ''))
  ));

  match /nilai/{siswaId} {
    // Baca nilai dibatasi pada dokumen penilaian milik Guru terkait.
    allow get: if sekolahSayaDoc() && (adminAktif() || kepsekAktif() || guruPemilikPenilaian(penilaianId));
    allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (adminAktif() || kepsekAktif() || guruPemilikPenilaian(penilaianId));

    allow create: if sekolahSayaReq() && (guruPemilikPenilaian(penilaianId)
      && nilaiSiswaValid(request.resource.data, penilaianId, siswaId)
      && request.resource.data.get('createdByUid', '') == request.auth.uid
      && request.resource.data.get('updatedByUid', '') == request.auth.uid);

    allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (guruPemilikPenilaian(penilaianId)
      && nilaiSiswaValid(request.resource.data, penilaianId, siswaId)
      && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
      && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
      && request.resource.data.get('updatedByUid', '') == request.auth.uid);

    allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (adminAktif() || kepsekAktif() || guruPemilikPenilaian(penilaianId));
  }
}
// =========================================================
// FOTO PROFIL GURU
// Simpan satu foto terkompresi per UID akun Guru.
// Tempel di dalam match /databases/{database}/documents,
// sejajar dengan match koleksi lainnya.
// =========================================================
match /foto_profil_guru/{userId} {
  // Foto hanya dapat dibaca oleh Guru pemilik akun.
  allow get: if sekolahSayaDoc() && (guruAktif() && request.auth.uid == userId);
  allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (false);

  // Foto disimpan sebagai data URL JPEG kecil (maksimal 480.000 karakter).
  // updatedAt harus berasal dari serverTimestamp().
  allow create: if sekolahSayaReq() && (guruAktif()
    && request.auth.uid == userId
    && request.resource.data.keys().hasAll(['fotoDataUrl', 'contentType', 'updatedAt'])
    && request.resource.data.keys().hasOnly(['fotoDataUrl', 'contentType', 'updatedAt'])
    && request.resource.data.get('fotoDataUrl', '') is string
    && request.resource.data.get('fotoDataUrl', '').size() <= 480000
    && request.resource.data.get('fotoDataUrl', '').matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
    && request.resource.data.get('contentType', '') == 'image/jpeg'
    && request.resource.data.get('updatedAt', null) is timestamp
    && request.resource.data.get('updatedAt', null) == request.time);
  allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (guruAktif()
    && request.auth.uid == userId
    && request.resource.data.keys().hasAll(['fotoDataUrl', 'contentType', 'updatedAt'])
    && request.resource.data.keys().hasOnly(['fotoDataUrl', 'contentType', 'updatedAt'])
    && request.resource.data.get('fotoDataUrl', '') is string
    && request.resource.data.get('fotoDataUrl', '').size() <= 480000
    && request.resource.data.get('fotoDataUrl', '').matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
    && request.resource.data.get('contentType', '') == 'image/jpeg'
    && request.resource.data.get('updatedAt', null) is timestamp
    && request.resource.data.get('updatedAt', null) == request.time);

  // Guru hanya dapat menghapus foto miliknya sendiri.
  allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (guruAktif() && request.auth.uid == userId);
}

// =========================================================
// FOTO PROFIL KEPALA SEKOLAH
// Satu foto terkompresi untuk setiap UID akun Kepsek.
// =========================================================

match /foto_profil_kepsek/{userId} {

  // Hanya Kepala Sekolah pemilik akun yang dapat membaca fotonya.
  allow get: if sekolahSayaDoc() && (kepsekAktif() && request.auth.uid == userId);
  allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (false);

  // Membuat atau memperbarui foto profil.
  allow create: if sekolahSayaReq() && (kepsekAktif()
    && request.auth.uid == userId
    && request.resource.data.keys().hasAll([
      'fotoDataUrl',
      'contentType',
      'updatedAt'
    ])
    && request.resource.data.keys().hasOnly([
      'fotoDataUrl',
      'contentType',
      'updatedAt'
    ])
    && request.resource.data.get('fotoDataUrl', '') is string
    && request.resource.data.get('fotoDataUrl', '').size() <= 480000
    && request.resource.data.get('fotoDataUrl', '').matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
    && request.resource.data.get('contentType', '') == 'image/jpeg'
    && request.resource.data.get('updatedAt', null) is timestamp
    && request.resource.data.get('updatedAt', null) == request.time);
  allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (kepsekAktif()
    && request.auth.uid == userId
    && request.resource.data.keys().hasAll([
      'fotoDataUrl',
      'contentType',
      'updatedAt'
    ])
    && request.resource.data.keys().hasOnly([
      'fotoDataUrl',
      'contentType',
      'updatedAt'
    ])
    && request.resource.data.get('fotoDataUrl', '') is string
    && request.resource.data.get('fotoDataUrl', '').size() <= 480000
    && request.resource.data.get('fotoDataUrl', '').matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
    && request.resource.data.get('contentType', '') == 'image/jpeg'
    && request.resource.data.get('updatedAt', null) is timestamp
    && request.resource.data.get('updatedAt', null) == request.time);

  // Hanya Kepala Sekolah pemilik akun yang dapat menghapus fotonya.
  allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (kepsekAktif() && request.auth.uid == userId);
}
   
    
// ==========================================
// MODUL AJAR PRIBADI GURU - LEGACY DAN V2
// ==========================================

function modulAjarV2Valid(data) {
  return data.keys().hasAll([
      'versiStruktur',
      'userId',
      'guruId',
      'namaGuru',
      'identitas',
      'identifikasiPesertaDidik',
      'desainPembelajaran',
      'kerangkaPembelajaranMendalam',
      'langkahPembelajaran',
      'pertemuanList',
      'asesmenList',
      'rubrikList',
      'pengayaanRemedial',
      'mediaList',
      'sumberBelajarList',
      'lkpdList',
      'lampiranList',
      'refleksi',
      'pengesahan',
      'createdAt',
      'updatedAt'
    ])
    && data.keys().hasOnly([
      'versiStruktur',
      'userId',
      'guruId',
      'namaGuru',
      'identitas',
      'identifikasiPesertaDidik',
      'desainPembelajaran',
      'kerangkaPembelajaranMendalam',
      'langkahPembelajaran',
      'pertemuanList',
      'asesmenList',
      'rubrikList',
      'pengayaanRemedial',
      'mediaList',
      'sumberBelajarList',
      'lkpdList',
      'lampiranList',
      'refleksi',
      'pengesahan',
      'createdAt',
      'updatedAt',
      'legacyData'
    ])
    && data.get('versiStruktur', 0) == 2
    && data.get('userId', '') is string
    && data.get('guruId', '') is string
    && data.get('namaGuru', '') is string

    // Validasi struktur utama
    && data.get('identitas', null) is map
    && data.get('identifikasiPesertaDidik', null) is map
    && data.get('desainPembelajaran', null) is map
    && data.get('kerangkaPembelajaranMendalam', null) is map
    && data.get('langkahPembelajaran', null) is map
    && data.get('pengayaanRemedial', null) is map
    && data.get('refleksi', null) is map
    && data.get('pengesahan', null) is map

    // Validasi identitas modul
    && data.get('identitas', {}).keys().hasAll([
      'judulModul',
      'namaSekolah',
      'namaPenyusun',
      'nipPenyusun',
      'jenjang',
      'kelas',
      'fase',
      'semester',
      'tahunAjaran',
      'mataPelajaran',
      'topik',
      'alokasiWaktu',
      'jumlahSiswa'
    ])
    && data.get('identitas', {}).get('jenjang', '') in ['SD', 'SMP']
    && data.get('identitas', {}).get('judulModul', '') is string

    // Validasi daftar dinamis
    && data.get('pertemuanList', null) is list
    && data.get('asesmenList', null) is list
    && data.get('rubrikList', null) is list
    && data.get('mediaList', null) is list
    && data.get('sumberBelajarList', null) is list
    && data.get('lkpdList', null) is list
    && data.get('lampiranList', null) is list

    // Waktu penyimpanan
    && data.get('createdAt', null) is timestamp
    && data.get('updatedAt', null) is timestamp

    // Data lama bersifat opsional
    && (
      !('legacyData' in data)
      || data.get('legacyData', null) is map
    );
}

match /modul_ajar/{modulId} {

  // Guru hanya dapat membaca modul miliknya sendiri.
  allow get: if sekolahSayaDoc() && (guruAktif()
    && resource.data.get('userId', '') == request.auth.uid);
  allow list: if sekolahValid() && resource.data.get('sekolahId', '') == dataProfil().get('sekolahId', '') && (guruAktif()
    && resource.data.get('userId', '') == request.auth.uid);

  // Membuat dokumen format lama atau V2.
  allow create: if sekolahSayaReq() && (guruAktif()
    && request.resource.data.get('userId', '') == request.auth.uid
    && request.resource.data.get('guruId', '') == dataProfil().get('guruId', '')
    && request.resource.data.get('namaGuru', '') is string
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time
    && (
      // Format V2
      modulAjarV2Valid(request.resource.data)

      ||

      // Format lama
      (
        request.resource.data.keys().hasAll([
          'userId', 'guruId', 'namaGuru', 'judulModul',
          'jenjang', 'kelas', 'fase', 'semester', 'tahunAjaran',
          'mataPelajaran', 'topik', 'alokasiWaktu',
          'cp', 'tp', 'kesiapanMurid', 'karakteristikMateri',
          'dimensiProfil', 'praktikPedagogis', 'kemitraan',
          'lingkungan', 'pemanfaatanDigital',
          'kegiatanAwal', 'kegiatanPenutup',
          'memahami', 'mengaplikasi', 'merefleksi',
          'asesmenAwal', 'asesmenProses', 'asesmenAkhir',
          'instrumen', 'tindakLanjut',
          'bahanAjar', 'lkpd', 'media', 'sumberBelajar',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'guruId', 'namaGuru', 'judulModul',
          'jenjang', 'kelas', 'fase', 'semester', 'tahunAjaran',
          'mataPelajaran', 'topik', 'alokasiWaktu',
          'cp', 'tp', 'kesiapanMurid', 'karakteristikMateri',
          'dimensiProfil', 'praktikPedagogis', 'kemitraan',
          'lingkungan', 'pemanfaatanDigital',
          'kegiatanAwal', 'kegiatanPenutup',
          'memahami', 'mengaplikasi', 'merefleksi',
          'asesmenAwal', 'asesmenProses', 'asesmenAkhir',
          'instrumen', 'tindakLanjut',
          'bahanAjar', 'lkpd', 'media', 'sumberBelajar',
          'createdAt', 'updatedAt'
        ])
      )
    ));

  // Memperbarui dokumen milik Guru.
  allow update: if sekolahSayaDoc() && sekolahTidakBerubah() && (guruAktif()
    && resource.data.get('userId', '') == request.auth.uid
    && request.resource.data.get('userId', '') == resource.data.get('userId', '')
    && request.resource.data.get('guruId', '') == resource.data.get('guruId', '')
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.updatedAt == request.time
    && (
      // Memperbarui dokumen V2
      (
        resource.data.get('versiStruktur', 0) == 2
        && modulAjarV2Valid(request.resource.data)
      )

      ||

      // Memperbarui dokumen lama
      (
        !('versiStruktur' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'namaGuru', 'judulModul', 'jenjang', 'kelas', 'fase',
          'semester', 'tahunAjaran', 'mataPelajaran', 'topik',
          'alokasiWaktu', 'cp', 'tp', 'kesiapanMurid',
          'karakteristikMateri', 'dimensiProfil', 'praktikPedagogis',
          'kemitraan', 'lingkungan', 'pemanfaatanDigital',
          'kegiatanAwal', 'kegiatanPenutup',
          'memahami', 'mengaplikasi', 'merefleksi',
          'asesmenAwal', 'asesmenProses', 'asesmenAkhir',
          'instrumen', 'tindakLanjut', 'bahanAjar', 'lkpd',
          'media', 'sumberBelajar', 'updatedAt'
        ])
      )
    ));

  // Guru hanya dapat menghapus modul miliknya.
  allow delete: if sekolahSayaDoc() && sekolahTidakBerubah() && (guruAktif()
    && resource.data.get('userId', '') == request.auth.uid);
}

  // ==========================================
  // PENDAFTARAN SEKOLAH PUBLIK
  // ==========================================

  function pendaftaranSekolahValid(data) {
    return data.keys().hasAll([
        'namaSekolah', 'npsn', 'jenjang', 'provinsi', 'kabupaten',
        'alamat', 'namaKepalaSekolah', 'email', 'telepon',
        'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'namaSekolah', 'npsn', 'jenjang', 'provinsi', 'kabupaten',
        'alamat', 'namaKepalaSekolah', 'email', 'telepon',
        'catatanPendaftar', 'catatanAdmin', 'status',
        'createdAt', 'updatedAt'
      ])
      && data.get('namaSekolah', '') is string
      && data.get('namaSekolah', '').size() >= 3
      && data.get('namaSekolah', '').size() <= 150
      && data.get('npsn', '') is string
      && data.get('npsn', '').matches('^[0-9]{8}$')
      && data.get('jenjang', '') in ['PAUD', 'TK', 'SD', 'SMP', 'SMA', 'SMK', 'SLB', 'Lainnya']
      && data.get('provinsi', '') is string
      && data.get('provinsi', '').size() >= 2
      && data.get('provinsi', '').size() <= 80
      && data.get('kabupaten', '') is string
      && data.get('kabupaten', '').size() >= 2
      && data.get('kabupaten', '').size() <= 100
      && data.get('alamat', '') is string
      && data.get('alamat', '').size() >= 5
      && data.get('alamat', '').size() <= 500
      && data.get('namaKepalaSekolah', '') is string
      && data.get('namaKepalaSekolah', '').size() >= 3
      && data.get('namaKepalaSekolah', '').size() <= 120
      && data.get('email', '') is string
      && data.get('email', '').size() >= 6
      && data.get('email', '').size() <= 254
      && data.get('email', '').matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')
      && data.get('telepon', '') is string
      && data.get('telepon', '').size() >= 8
      && data.get('telepon', '').size() <= 20
      && data.get('catatanPendaftar', '') is string
      && data.get('catatanPendaftar', '').size() <= 1000
      && data.get('catatanAdmin', '') == ''
      && data.get('status', '') == 'menunggu_verifikasi'
      && data.get('createdAt', null) is timestamp
      && data.get('createdAt', null) == request.time
      && data.get('updatedAt', null) is timestamp
      && data.get('updatedAt', null) == request.time;
  }

  match /pendaftaran_sekolah/{pendaftaranId} {
    // Hanya Platform Owner yang dapat membaca data pendaftaran.
    allow get, list: if sudahLogin()
      && request.auth.token.platformOwner == true;

    // Pengunjung yang belum login hanya dapat mengirim pendaftaran baru.
    // Data awal dibatasi ketat dan status awal harus menunggu verifikasi.
    allow create: if (request.auth == null || sudahLogin())
      && pendaftaranSekolahValid(request.resource.data);

    // Hanya Platform Owner yang dapat mengubah keputusan pemeriksaan.
    allow update: if sudahLogin()
      && request.auth.token.platformOwner == true
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'catatanAdmin', 'ditinjauOleh',
        'ditinjauEmail', 'ditinjauPada', 'updatedAt'
      ])
      && request.resource.data.get('status', '') in [
        'menunggu_verifikasi', 'perlu_perbaikan', 'ditolak',
        'disetujui_menunggu_provisioning', 'selesai'
      ]
      && request.resource.data.get('catatanAdmin', '') is string
      && request.resource.data.get('catatanAdmin', '').size() <= 1000
      && request.resource.data.get('ditinjauOleh', '') is string
      && request.resource.data.get('ditinjauEmail', '') is string
      && request.resource.data.get('ditinjauPada', null) is timestamp
      && request.resource.data.get('updatedAt', null) is timestamp
      && request.resource.data.get('updatedAt', null) == request.time;

    // Pendaftaran tidak dihapus dari aplikasi agar jejak pemeriksaan tetap ada.
    allow delete: if false;
  }

  // Semua aturan lama tetap dipertahankan.
  // Jangan dihapus.

  // Aturan registry sekolah untuk Platform Owner.
  match /sekolah_platform/{sekolahId} {
    allow read, create, update: if sudahLogin()
      && request.auth.token.platformOwner == true;

    allow delete: if false;
  }

    // ==========================================
    // CATCH-ALL: DIHAPUS TOTAL.
    // ==========================================
  }
}
